<?xml version="1.0" encoding="UTF-8"?>

<!--
  One turn of the conversation: the words beside the face that said them.

  The root is fx:root rather than a named element, so that DialogBox can set
  itself as both the root and the controller. Without that, every dialog box
  would need a separate controller object.

  Reused from https://se-education.org/guides/tutorials/javaFxPart4.html
  with minor modifications: the picture keeps the 100 pixel size the
  hand-written version used.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_RIGHT"
         maxHeight="1.7976931348623157E308"
         maxWidth="1.7976931348623157E308"
         prefWidth="400.0"
         spacing="5.0"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
  <children>
    <Label fx:id="dialog" minHeight="-Infinity" text="Label" wrapText="true" />
    <ImageView fx:id="displayPicture"
               fitHeight="100.0" fitWidth="100.0"
               pickOnBounds="true" preserveRatio="true" />
  </children>
  <padding>
    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
  </padding>
</fx:root>
