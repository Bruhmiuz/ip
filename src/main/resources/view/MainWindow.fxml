<?xml version="1.0" encoding="UTF-8"?>

<!--
  The layout of the chat window. Every size and position that used to be set
  in MainWindow.java is here instead, so that the look of the window can be
  changed without touching the code that runs the bot.

  Reused from https://se-education.org/guides/tutorials/javaFxPart4.html
  and https://se-education.org/guides/tutorials/javaFxPart5.html with minor
  modifications: the controller name carries this project's package, and the
  sizes are this project's own.

  Every control is anchored to an edge rather than given a fixed position, so
  the window can be resized and the conversation takes the extra room.
-->

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="400.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gudgoi.gui.MainWindow">
  <stylesheets>
    <URL value="@main.css" />
  </stylesheets>
  <children>
    <ScrollPane fx:id="scrollPane"
                fitToWidth="true"
                hbarPolicy="NEVER"
                hvalue="1.0"
                vvalue="1.0"
                AnchorPane.topAnchor="0.0"
                AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0"
                AnchorPane.bottomAnchor="40.0">
      <content>
        <VBox fx:id="dialogContainer" />
      </content>
    </ScrollPane>
    <TextField fx:id="userInput"
               onAction="#handleUserInput"
               prefHeight="40.0"
               promptText="Type a command, then press Enter"
               AnchorPane.bottomAnchor="0.0"
               AnchorPane.leftAnchor="0.0"
               AnchorPane.rightAnchor="75.0" />
    <Button fx:id="sendButton"
            mnemonicParsing="false"
            onAction="#handleUserInput"
            prefHeight="40.0"
            prefWidth="75.0"
            text="Send"
            AnchorPane.bottomAnchor="0.0"
            AnchorPane.rightAnchor="0.0" />
  </children>
</AnchorPane>
